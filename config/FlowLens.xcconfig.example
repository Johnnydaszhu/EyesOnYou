// Public example only — safe to commit.
//
// DO NOT put your real Apple Team ID, personal bundle IDs, or App Groups here.
// Copy this file to a gitignored local override instead, e.g.:
//   cp config/FlowLens.xcconfig.example config/Local.xcconfig
// then set DEVELOPMENT_TEAM and real identifiers privately.
//
// Tracked project files intentionally use:
//   PRODUCT_BUNDLE_IDENTIFIER = com.example.FlowLens
//   DEVELOPMENT_TEAM = ""
//   CODE_SIGN_IDENTITY = "-"

FLOWLENS_APP_BUNDLE_ID = com.example.FlowLens
FLOWLENS_EXTENSION_BUNDLE_ID = com.example.FlowLens.NetworkExtension
// TeamIdentifierPrefix is injected by Xcode when signing with a real Team.
FLOWLENS_APP_GROUP = $(TeamIdentifierPrefix)com.example.FlowLens
FLOWLENS_MACH_SERVICE = $(TeamIdentifierPrefix)com.example.FlowLens.provider
FLOWLENS_MIN_MACOS = 13.0

// Leave empty in any file that might be committed.
// DEVELOPMENT_TEAM = YOUR_TEAM_ID_IN_LOCAL_XCCONFIG_ONLY

MACOSX_DEPLOYMENT_TARGET = $(FLOWLENS_MIN_MACOS)
SWIFT_VERSION = 6.0
ENABLE_HARDENED_RUNTIME = YES
DEAD_CODE_STRIPPING = YES
STRIP_INSTALLED_PRODUCT = YES
